// Cloudflare Workers config for Tone Zone Survivors.
// The game is static files with no build step: `npm run build` copies index.html and src/ into ./dist,
// and Workers serves ./dist. Cloudflare's GitHub connection runs the build and `npx wrangler deploy` on each push to main.
{
  "name": "tonezone-survivor",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  "workers_dev": true,
  "preview_urls": true
}
